{
  "manifest_version": 3,
  "name": "Stream to Sonos",
  "version": "0.1.0",
  "description": "Überträgt Tab-Ton lokal auf Sonos. Ohne Konto oder Cloud.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stream to Sonos"
  },
  "key": ""
}
